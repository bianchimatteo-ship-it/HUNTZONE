{
  "name": "huntzone-web-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:github-pages": "tsc -b && vite build --mode github-pages",
    "typecheck": "tsc -b --pretty && tsc --noEmit -p packages/game-core/tsconfig.json",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
