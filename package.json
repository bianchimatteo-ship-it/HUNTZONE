{
  "name": "huntzone-web-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:github-pages": "tsc -b && vite build --mode github-pages",
    "typecheck": "tsc -b --pretty && tsc --noEmit -p packages/game-core/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/test-multiplayer-e2e.mjs",
    "api:dev": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "api:migrate": "node --env-file-if-exists=.env --import tsx apps/api/src/migrate.ts",
    "api:typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "maplibre-gl": "6.16.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
